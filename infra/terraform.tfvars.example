# Copy to terraform.tfvars. Nothing here is secret: secrets are set out of band.
# The hosts run only ghcr.io/<ghcr_owner>/rsk-vrf-worker@sha256:<digest>.
# ghcr_owner        = "mangekyou-labs"
worker_image        = "ghcr.io/mangekyou-labs/rsk-vrf-worker@sha256:<digest from the Worker image workflow>"
coordinator_address = "0x<VRF Coordinator on chain 31>"

drand_pin = {
  public_key = "0x<word0>,0x<word1>,0x<word2>,0x<word3>"
  genesis    = 0 # <genesis_time>
  period     = 3
}

# keyHashes whose empty rsk-vrf/proving-key/<keyHash> secrets to create in both regions.
proving_key_hashes = []
