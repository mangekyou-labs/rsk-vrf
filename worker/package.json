{
  "name": "@rsk-vrf/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "worker": "./src/main.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --test --test-concurrency=1 integration/*.test.ts",
    "start": "node src/run.ts",
    "demo:dice": "node demo/dice.ts",
    "demo:read-path": "node demo/read-path.ts",
    "demo:reverting-consumer": "node demo/reverting-consumer.ts",
    "demo:withdraw-fees": "node demo/withdraw-fees.ts",
    "demo:recompute-beta": "node demo/recompute-beta.ts",
    "demo:rejections": "node demo/rejections.ts",
    "demo:check-withheld-proof": "node demo/check-withheld-proof.ts",
    "demo:missed-deadlines": "node demo/missed-deadlines.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1156.0",
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
